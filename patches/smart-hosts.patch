+// ApplyHosts 按 hosts 改写目标：IP 记录改为 IP，域名记录改为映射后的域名
+func ApplyHosts(metadata *C.Metadata) {
+	if metadata.Host == "" {
+		return
+	}
+	node, ok := resolver.DefaultHosts.Search(metadata.Host, false)
+	if ok {
+		if ip, err := node.RandIP(); err == nil {
+			metadata.DstIP, metadata.Host = ip, ""
+		}
+	} else if node != nil && node.IsDomain {
+		metadata.Host = node.Domain
+	}
+}
